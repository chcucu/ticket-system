# ============================================================
# 通用工单系统 - 后端环境变量示例
# 复制本文件为 .env 并按实际情况填写，勿将 .env 提交到版本库
# ============================================================

# ---- 服务端口 ----
PORT=3000

# ---- 品牌信息（开源自定义入口，邮件/标题等展示用） ----
BRAND_NAME=工单系统
BRAND_TEAM=管理团队

# ---- MySQL 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ticket_system

# ---- SMTP 邮件配置（nodemailer） ----
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_sender@example.com
MAIL_PASS=your_smtp_auth_code
MAIL_FROM=工单系统 <your_sender@example.com>

# ---- 管理员鉴权（登录密码 / JWT） ----
ADMIN_PASSWORD=admin_secret_password
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- 图片上传 ----
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=2
MAX_IMAGE_COUNT=9
